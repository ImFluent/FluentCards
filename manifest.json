{
  "manifest_version": 3,
  "name": "FluentCards — Learn YouTube words instantly",
  "short_name": "FluentCards",
  "version": "1.3.1",
  "description": "Turn any word you click in YouTube subtitles into a flashcard with its meaning, the sentence, and a movie clip. Review daily.",
  "key": "",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "https://*.wiktionary.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://tatoeba.org/*",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["lib/storage.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
      "js": ["bridge.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FluentCards",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
